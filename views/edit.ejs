
<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <title>메뉴 수정</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            background: #f5f5f5;
            padding: 30px;
        }
        .container {
            width: 400px;
            margin: auto;
            background: white;
            padding: 25px;
            border-radius: 10px;
        }
        h1 { text-align: center; }
        input, select {
            width: 100%;
            padding: 10px;
            margin: 8px 0 15px;
            box-sizing: border-box;
        }
        button, a {
            padding: 10px 15px;
            border: none;
            border-radius: 5px;
            text-decoration: none;
            cursor: pointer;
        }
        button {
            background: #0d6efd;
            color: white;
        }
        a {
            background: #777;
            color: white;
        }
    </style>
</head>
<body>
<div class="container">
    <h1>메뉴 수정</h1>

    <form action="/edit/<%= menu.id %>" method="POST">
        <label>메뉴 이름</label>
        <input type="text" name="menu"
               value="<%= menu.menu %>" required>

        <label>종류</label>
        <select name="category" required>
            <option value="커피"
                <%= menu.category === "커피" ? "selected" : "" %>>
                커피
            </option>
            <option value="티"
                <%= menu.category === "티" ? "selected" : "" %>>
                티
            </option>
            <option value="디저트"
                <%= menu.category === "디저트" ? "selected" : "" %>>
                디저트
            </option>
        </select>

        <label>가격</label>
        <input type="number" name="price"
               value="<%= menu.price %>" min="0" required>

        <button type="submit">수정 완료</button>
        <a href="/">취소</a>
    </form>
</div>
</body>
</html>

